# ============================================================
# any_gateway 环境变量示例
# 复制此文件为 .env 并填入实际值，切勿将 .env 提交到版本控制。
# ============================================================

# ---- LDAP / Active Directory 认证配置 ----

# LDAP 服务器地址（ldap:// 或 ldaps://）
# 示例: ldap://dc.company.internal
# LDAP_SERVER_URL=ldap://dc.company.internal

# LDAP 搜索基础 DN
# 示例: DC=company,DC=internal
LDAP_BASE_DN=DC=company,DC=internal

# NetBIOS 域名（用于拼接 DOMAIN\username 绑定字符串）
# 示例: COMPANY
LDAP_DOMAIN=COMPANY

# ---- 服务器配置 ----

# 网关服务端口
GATEWAY_PORT=8003

# ---- Admin API 密钥 ----

# 管理接口的认证密钥（Bearer token），用于保护 /admin/* 路由。
# 强烈建议使用高强度随机字符串，例如:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=your-admin-key-here    # 必须设置！用于保护 /admin/* 路由

# ---- 应急管理员登录 ----

# 当 LDAP 不可用时的离线 fallback 密钥。
# 使用方式: 用户名填 _admin_fallback，密码填此值。
# 强烈建议使用高强度随机字符串，例如:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_FALLBACK_KEY=your-fallback-key-here    # 可选，离线应急账号密码。运行: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- React 前端 JWT 认证 ----

JWT_SECRET=your-jwt-secret-here
SUPERADMIN_USERNAME=superadmin


# ---- 其他配置 ----

NUM_LOG_CONSUMERS=3  # 日志消费者数量,建议 2-5